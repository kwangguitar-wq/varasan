{
  "name": "nakhonmaesot-library",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Nakhonmaesot Library — ศูนย์รวมวารสารและหนังสืออิเล็กทรอนิกส์",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"node --watch server/index.js\" \"vite\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "node server/index.js",
    "seed": "node server/seed.js --force",
    "seed:pack": "node scripts/pack-seed.mjs",
    "seed:cloud": "node scripts/seed-cloud.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "pwa:icons": "node scripts/pwa-icons.mjs",
    "pwa:shots": "node scripts/pwa-screenshots.mjs",
    "test:pwa": "node scripts/pwa-check.mjs",
    "worker:dev": "wrangler dev --config wrangler.jsonc --port 8789",
    "worker:build": "npm run build && npm run seed:pack && wrangler deploy --dry-run --outdir sites-build --config wrangler.jsonc",
    "test:book": "node scripts/book-check.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "@pdf-lib/fontkit": "^1.1.1",
    "@vercel/blob": "^2.8.2",
    "aws4fetch": "^1.0.20",
    "express": "^5.1.0",
    "fflate": "^0.8.2",
    "multer": "^2.0.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.54",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.1.2",
    "playwright": "^1.64.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wrangler": "^4.151.3"
  }
}
