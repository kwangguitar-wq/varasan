{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nakhonmaesot-library",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nakhonmaesot-library",
      "database_id": "00000000-0000-0000-0000-0000000000db"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "nakhonmaesot-library-files"
    }
  ],
  "observability": {
    "enabled": true
  }
}
