
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "varasan",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "B2_BUCKET": "nakhonmaesot-library-files",
    "B2_ENDPOINT": "https://s3.us-east-005.backblazeb2.com",
    "B2_REGION": "us-east-005"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nakhonmaesot-library",
      "database_id": "e7923358-de19-4216-8c65-83d25fe128c9"
    }
  ],
  "observability": {
    "enabled": true
  }
}
