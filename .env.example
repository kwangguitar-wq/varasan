# ฐานข้อมูลคลาวด์สำหรับ Vercel (Turso / libSQL)
# สร้างได้ที่ Vercel → Storage → Marketplace (Turso) แล้วค่าจะถูกเพิ่มให้อัตโนมัติ
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ที่เก็บไฟล์อัปโหลด (Cloudflare R2 ผ่าน S3 API)
# สร้าง bucket ที่ Cloudflare dashboard → R2 → Create bucket
# แล้วสร้าง API token แบบ Object Read & Write เพื่อเอา Access Key ID / Secret
# ตั้ง FILE_STORAGE=r2 เพื่อบังคับใช้ R2 (ถ้าตั้งค่าไม่ครบ ระบบจะปิดการอัปโหลด
# แทนที่จะเก็บไฟล์ลงฐานข้อมูลซึ่งจะหายเมื่อดีพลอยใหม่)
FILE_STORAGE=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# ไม่บังคับ: ใช้เมื่อ bucket อยู่นอก endpoint มาตรฐาน (เช่น EU jurisdiction)
# R2_ENDPOINT=https://<account_id>.eu.r2.cloudflarestorage.com

# ทางเลือกแทน R2: Vercel Blob
BLOB_READ_WRITE_TOKEN=
